# ── Base de datos (Supabase Postgres) ────────────────────────────
# En Supabase: Project Settings → Database → Connection string (URI).
# Usa el "connection pooler" (puerto 6543) en producción si el VPS no soporta IPv6.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.xxxx.supabase.co:5432/postgres

# ── Sesiones de administrador ────────────────────────────────────
# Cualquier cadena larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# ── Usuario administrador inicial (lo crea `npm run db:seed`) ────
ADMIN_EMAIL=admin@agroaper.es
ADMIN_PASSWORD=cambia-esta-contrasena

# ── IA (API OpenAI-compatible, tu propia key) ────────────────────
# OpenAI:    AI_BASE_URL=https://api.openai.com/v1      AI_MODEL=gpt-4o-mini
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1  AI_MODEL=openai/gpt-4o-mini
# Groq:      AI_BASE_URL=https://api.groq.com/openai/v1 AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── Supabase Storage (adjuntos de las solicitudes) ───────────────
# Project Settings → API → Project URL y service_role key (¡solo servidor!)
# Crea un bucket PRIVADO llamado "adjuntos" en Storage (o cambia SUPABASE_BUCKET).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=adjuntos

# ── Chat con Relevance AI (opcional) ─────────────────────────────
# Si lo configuras, la web usa el widget de chat de tu agente de Relevance
# en lugar del chat integrado. Ver la sección "Relevance AI" de DESPLIEGUE.md.
#
# Secreto compartido para el webhook (cadena larga aleatoria, como APP_SECRET):
RELEVANCE_WEBHOOK_SECRET=
# Snippet de incrustación (Agent → Share → Chat Widget). SOLO frontend:
VITE_RELEVANCE_EMBED_SNIPPET=
